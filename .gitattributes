# Enforce LF line endings to avoid LF-will-become-CRLF warnings under core.autocrlf=true.
*.editorconfig text eol=lf
*.gitignore text eol=lf
*.go text eol=lf
*.json text eol=lf
*.md text eol=lf
*.mod text eol=lf
*.ps1 text eol=lf
*.ps1xml text eol=lf
*.sum text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.dll binary
*.exe binary
internal/shim/assets/*.exe binary
